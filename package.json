{
  "name": "wishlist-sale-forecast",
  "version": "1.0.0",
  "description": "Millennium plugin: expected cost of a Steam wishlist at the next seasonal sale",
  "license": "MIT",
  "author": "Danila",
  "type": "module",
  "scripts": {
    "dev": "millennium-ttc --build dev",
    "watch": "millennium-ttc --build dev --watch",
    "build": "millennium-ttc --build prod",
    "typecheck": "tsc -p frontend --noEmit && tsc -p webkit --noEmit"
  },
  "dependencies": {
    "@steambrew/api": "^5.8.4",
    "@steambrew/client": "^5.8.5",
    "@steambrew/ttc": "^3.3.7",
    "@steambrew/webkit": "^5.8.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
